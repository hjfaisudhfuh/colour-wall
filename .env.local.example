# Public site URL — used for Stripe success/cancel redirect URLs.
# Local: http://localhost:3000  |  Prod: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase — service role key is SERVER ONLY. Never expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Pricing (cents). Default 100 = $1.
PRICE_CENTS=100
